# flyctl launch added from node_modules/.gitignore
# Environment variables (NEVER commit tokens/secrets)
node_modules/**/.env
node_modules/**/.env.local
node_modules/**/.env.*.local

# Dependencies
node_modules/**/node_modules

# Logs
node_modules/**/npm-debug.log*
node_modules/**/yarn-debug.log*
