# OS files
node_modules/**/.DS_Store
node_modules/**/Thumbs.db

# Editor folders
node_modules/**/.vscode
node_modules/**/.idea

# Build output (if you ever add one)
node_modules/**/dist
node_modules/**/build
fly.toml
